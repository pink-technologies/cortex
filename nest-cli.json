{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/api/src",
  "monorepo": true,
  "root": "apps/api",
  "projects": {
    "api": {
      "type": "application",
      "root": "apps/api",
      "entryFile": "main",
      "sourceRoot": "apps/api/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api/tsconfig.app.json",
        "assets": [
          {
            "include": "i18n/locales/**/*",
            "watchAssets": true,
            "outDir": "dist/apps/api"
          }
        ]
      }
    },
    "node": {
      "type": "application",
      "root": "apps/node",
      "entryFile": "main",
      "sourceRoot": "apps/node/src",
      "compilerOptions": {
        "tsConfigPath": "apps/node/tsconfig.app.json"
      }
    }
  },
  "compilerOptions": {
    "deleteOutDir": true,
    "tsConfigPath": "apps/api/tsconfig.app.json",
    "watchAssets": true,
    "assets": [
      {
        "include": "i18n/locales/**/*",
        "watchAssets": true,
        "outDir": "dist/apps/api"
      }
    ]
  }
}
