# Cortex API environment (copy values into env/.env.development)
#
# Startup fails closed when required values are missing or invalid
# (see createApiConfiguration). DATABASE_URL is required. PORT and REDIS_URL
# default when omitted. Webhook / operator secrets stay optional at process
# start and return HTTP 503 until configured.

# Database (required)
# Apply schema from an empty database with: pnpm db:migrate
DATABASE_URL=postgresql://postgres:@localhost:5432/cortex

# Optional
# PORT=3000
# REDIS_URL=redis://localhost:6379

# GitHub webhook
# Create a repo/org webhook pointing to:
#   POST https://<host>/api/webhooks/github
# Events: subscribe to whatever handlers need (today: Pull requests)
GITHUB_WEBHOOK_SECRET=
GITHUB_DEFAULT_CONNECTION_ID=github-main
# GITHUB_REVIEW_INSTRUCTIONS=Focus on correctness and security.

# Jira webhook → jira.triage
# Create a Jira webhook pointing to:
#   POST https://<host>/api/webhooks/jira/jira-triage
# Events: Issue updated (assignee)
JIRA_WEBHOOK_SECRET=
JIRA_DEFAULT_CONNECTION_ID=jira-main
# JIRA_AUTOMATION_ASSIGNEE_ACCOUNT_ID=jira-account-id-of-bot

# Workflow operator endpoints
# WORKFLOW_OPERATOR_TOKEN=
