// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  // Stable path so the IDE resolves types via node_modules/.prisma (pnpm nests the default output).
  output   = "../../../../../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum ExecutionJobStatus {
  QUEUED
  RUNNING
  AWAITING_REVIEW
  COMPLETED
  FAILED
  CANCELLED
  INTERRUPTED
}

enum ExecutionJobEventSource {
  ORCHESTRATOR
  WORKER
  HANDLER
  EXTERNAL
}

enum WorkflowRunStatus {
  PENDING
  RUNNING
  AWAITING_APPROVAL
  COMPLETED
  FAILED
  CANCELLED
}

enum WorkflowStepKind {
  JOB
  APPROVAL
}

enum WorkflowStepStatus {
  PENDING
  QUEUED
  RUNNING
  AWAITING_APPROVAL
  COMPLETED
  FAILED
  SKIPPED
  CANCELLED
}

enum WorkflowApprovalDecisionOutcome {
  APPROVED
  REJECTED
}

model WorkflowRun {
  id String @id @default(uuid())

  definitionKey     String
  definitionVersion Int                @default(1)
  status            WorkflowRunStatus  @default(PENDING)

  input   Json
  result  Json?
  failure Json?

  triggerIdentifier String? @unique
  activeKey         String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  startedAt   DateTime?
  completedAt DateTime?
  failedAt    DateTime?

  approvalDecisions WorkflowApprovalDecision[]
  steps             WorkflowStep[]
  jobs              ExecutionJob[]

  @@index([status, createdAt])
  @@index([definitionKey, status])
  @@map("workflow_run")
}

model WorkflowStep {
  id String @id @default(uuid())

  runId String
  run   WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  key      String
  position Int
  kind     WorkflowStepKind
  status   WorkflowStepStatus @default(PENDING)

  jobKind String?

  input  Json?
  output Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  startedAt   DateTime?
  completedAt DateTime?
  failedAt    DateTime?

  approvalDecisions WorkflowApprovalDecision[]
  jobs              ExecutionJob[]

  @@unique([runId, key])
  @@unique([runId, position])
  @@index([runId, status])
  @@map("workflow_step")
}

model WorkflowApprovalDecision {
  id String @id @default(uuid())

  /**
   * Client-supplied idempotency key for this decision command.
   */
  decisionId String @unique

  runId String
  run   WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  stepId String
  step   WorkflowStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  outcome WorkflowApprovalDecisionOutcome
  actorId String
  reason  String?

  createdAt DateTime @default(now())

  @@index([runId, createdAt])
  @@index([stepId])
  @@map("workflow_approval_decision")
}

model ExecutionJob {
  id String @id @default(uuid())

  kind           String
  payloadVersion Int    @default(1)

  status ExecutionJobStatus @default(QUEUED)
  stage  String?

  priority    Int      @default(0)
  availableAt DateTime @default(now())

  payload      Json
  requirements Json
  policy       Json

  result  Json?
  failure Json?

  sourceType       String?
  sourceIdentifier String?

  claimToken      String?
  claimedByNodeId String?

  maximumAttempts Int @default(1)

  runId String?
  run   WorkflowRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  stepId String?
  step   WorkflowStep? @relation(fields: [stepId], references: [id], onDelete: SetNull)

  cancellationRequestedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  startedAt   DateTime?
  completedAt DateTime?
  failedAt    DateTime?

  events ExecutionJobEvent[]

  @@index([status, priority, availableAt, createdAt])
  @@index([kind, status])
  @@index([sourceType, sourceIdentifier])
  @@index([runId, status])
  @@index([stepId])
  @@map("execution_job")
}

/// Reserved for future durable job lifecycle events. Not written by the
/// current claim/complete path.
model ExecutionJobEvent {
  id             String                 @id @default(uuid())
  jobId          String
  job            ExecutionJob           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  idempotencyKey String?                @unique
  source         ExecutionJobEventSource
  type           String
  payload        Json?
  createdAt      DateTime               @default(now())

  @@index([jobId, createdAt])
  @@index([type, createdAt])
  @@map("execution_job_event")
}

enum AgentStatus {
  ACTIVE
  DEPRECATED
}

enum Role {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum ModelProviderType {
  OPENAI
  AZURE
  GEMINI
  CLAUDE
}

enum ConnectionRole {
  PRIMARY
  FALLBACK
  CLASSIFIER
}

enum SkillInstallationStatus {
  DISABLED
  ENABLED
}

enum SkillInstallationScopeType {
  GLOBAL
  USER
  WORKSPACE
}

enum SkillStatus {
  ARCHIVED
  ACTIVE
  DISABLED
  DRAFT
}

enum NodeArchitecture {
  ARM64
  X64
}

enum NodeOperatingSystem {
  MACOS
  LINUX
  WINDOWS
}

enum NodeState {
  ENABLED
  DISABLED
  REVOKED
}

model Agent {
  id          String            @id @default(uuid())
  createdAt   DateTime          @default(now())
  description String?
  name        String
  status      AgentStatus       @default(ACTIVE)
  updatedAt   DateTime          @updatedAt
  agentSkills AgentSkill[]
  connections AgentConnection[]
  intents     AgentIntent[]

  @@map("agent")
}

model AgentConnection {
  id                String         @id @default(uuid())
  agentId           String
  modelConnectionId String
  role              ConnectionRole @default(PRIMARY)
  isDefault         Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  agent           Agent           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  modelConnection ModelConnection @relation(fields: [modelConnectionId], references: [id], onDelete: Cascade)

  @@unique([agentId, modelConnectionId])
  @@index([agentId])
  @@index([modelConnectionId])
  @@map("agent_model_connection")
}

model AgentSkill {
  id        String   @id @default(uuid())
  agentId   String
  skillId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent Agent @relation(fields: [agentId], references: [id])
  skill Skill @relation(fields: [skillId], references: [id])

  @@unique([agentId, skillId])
  @@map("agent_skill")
}

model Chat {
  id        String   @id @default(uuid())
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@map("chat")
}

model AgentIntent {
  id        String   @id @default(uuid())
  agentId   String
  intentId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent  Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  intent Intent @relation(fields: [intentId], references: [id], onDelete: Cascade)

  @@unique([agentId, intentId])
  @@index([agentId])
  @@index([intentId])
  @@map("agent_intent")
}

/// Server-side registration for an execution Node.
///
/// This is the only Node persistence model in the API database. Agent-local
/// installation identity (`NodeIdentityStore`) is separate and not stored here.
model ExecutionNode {
  id String @id @default(uuid()) @db.Uuid

  installationId String @unique @db.Uuid
  name           String  @db.VarChar(128)

  operatingSystem NodeOperatingSystem
  architecture    NodeArchitecture
  state           NodeState @default(ENABLED)

  capabilities   String[] @default([])
  labels         String[] @default([])
  supportedKinds String[] @default([])

  version    String?  @db.VarChar(64)
  lastSeenAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([state])
  @@index([lastSeenAt])
  @@index([operatingSystem, architecture])
  @@map("nodes")
}

model Intent {
  id           String        @id @default(uuid())
  slug         String
  name         String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  agentIntents AgentIntent[]

  @@unique([slug])
  @@map("intent")
}

model Message {
  id        String   @id @default(uuid())
  chatId    String
  role      Role
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId])
  @@map("message")
}

model Model {
  id              String   @id @default(uuid())
  slug            String
  name            String
  description     String?
  modelProviderId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  modelProvider    ModelProvider     @relation(fields: [modelProviderId], references: [id], onDelete: Cascade)
  modelConnections ModelConnection[]

  @@unique([slug])
  @@index([modelProviderId])
  @@map("model")
}

model ModelConnection {
  id        String   @id @default(uuid())
  modelId   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  model       Model             @relation(fields: [modelId], references: [id], onDelete: Cascade)
  connections AgentConnection[]

  @@index([modelId])
  @@map("model_connection")
}

model ModelProvider {
  id          String            @id @default(uuid())
  slug        String
  name        String
  description String?
  type        ModelProviderType
  config      Json
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  models      Model[]

  @@unique([slug])
  @@map("model_provider")
}

model Skill {
  id          String      @id @default(uuid())
  slug        String      @unique
  name        String
  description String?
  status      SkillStatus @default(ACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  installations              SkillInstallation[]
  agentSkills                AgentSkill[]
  skillDatasourceConnections SkillDatasourceConnection[]
  skillTools                 SkillTool[]

  @@map("skill")
}

enum DatasourceAuthType {
  NONE
  API_KEY
  EMAIL_PASSWORD
  USERNAME_PASSWORD
  TOKEN

  @@map("datasource_auth_type")
}

model DatasourceProvider {
  id                    String                 @id @default(uuid())
  slug                  String
  name                  String
  description           String?
  authType              DatasourceAuthType     @default(NONE)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  datasourceConnections DatasourceConnection[]

  @@unique([slug])
  @@map("datasource_provider")
}

model DatasourceConnection {
  id          String   @id @default(uuid())
  slug        String
  name        String
  description String?
  providerId  String
  config      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  provider                   DatasourceProvider          @relation(fields: [providerId], references: [id], onDelete: Cascade)
  skillDatasourceConnections SkillDatasourceConnection[]

  @@unique([slug])
  @@index([providerId])
  @@map("datasource_connection")
}

model SkillDatasourceConnection {
  id           String   @id @default(uuid())
  skillId      String
  connectionId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  skill      Skill                @relation(fields: [skillId], references: [id], onDelete: Cascade)
  connection DatasourceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([skillId, connectionId])
  @@map("skill_connection")
}

model Tool {
  id           String        @id @default(uuid())
  slug         String
  name         String
  description  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  toolVersions ToolVersion[]
  skillTools   SkillTool[]

  @@unique([slug])
  @@map("tool")
}

model ToolVersion {
  id        String   @id @default(uuid())
  toolId    String
  version   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tool Tool @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([toolId, version])
  @@map("tool_version")
}

model SkillTool {
  id        String   @id @default(uuid())
  skillId   String
  toolId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  tool  Tool  @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([skillId, toolId])
  @@map("skill_tool")
}

model SkillInstallation {
  id               String                     @id @default(uuid())
  skillId          String
  scopeType        SkillInstallationScopeType
  scopeId          String
  installationPath String?
  status           SkillInstallationStatus    @default(ENABLED)
  config           Json?
  installedBy      String?
  installedAt      DateTime                   @default(now())
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([scopeType, scopeId, skillId])
  @@index([scopeType, scopeId])
  @@map("skill_installation")
}
