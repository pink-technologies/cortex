# Cortex API
CORTEX_API_URL=http://localhost:3000/api
CORTEX_NODE_ID=cortex-node-local
CORTEX_NODE_NAME=Local Cortex Node
CORTEX_NODE_VERSION=0.1.0
CORTEX_POLL_INTERVAL_MS=2000

# LLM providers (at least one required for agent.execute)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Required when this Node advertises repository.review (Cursor execution engine)
CURSOR_API_KEY=

# Required when this Node advertises repository.review.
# JSON array of Node-local source-control connections. Job payloads reference
# connectionId; tokens never travel on the wire.
# Example:
# CORTEX_SC_CONNECTIONS=[{"id":"github-main","provider":"github","token":"ghp_xxx"}]
CORTEX_SC_CONNECTIONS=

# Required when this Node advertises jira.triage.
# Example:
# CORTEX_JIRA_CONNECTIONS=[{"id":"jira-main","provider":"jira","baseUrl":"https://example.atlassian.net","email":"bot@example.com","apiToken":"xxx"}]
CORTEX_JIRA_CONNECTIONS=

# Project key → GitHub repo + named suites + optional area routing for jira.triage.
# Legacy unitTestCommand/uiTestCommand still work when `suites` is omitted.
# Example (multiline single-quoted JSON is supported by Node loadEnvFile):
# Optional projectLead.email is looked up in Jira for @-mention + reassignment (no accountId in config).
# SWIFTSCOPE_PATHS= skips Truvideo SwiftLint/SwiftFormat run-script phases during xcodebuild test.
# Prefer `xcodegen generate` (or `make generate`) over `make genbuild` — genbuild also builds
# all schemes (with lint) and opens Xcode.
# Do not hard-code `-destination`: TestRunner resolves an available iPhone simulator on the
# Node (booted preferred, else first available) and appends/rewrites `-destination` for
# `xcodebuild test` commands.
# CORTEX_JIRA_PROJECT_REPOS='[{"projectKey":"SCRUM","owner":"Truvideo","name":"truvideo-ios-sdk","cloneUrl":"https://github.com/Truvideo/truvideo-ios-sdk.git","defaultBranch":"main","sourceControlConnectionId":"Truvideo","projectLead":{"email":"jorge@pink-tech.io"},"suites":{"TruvideoSdk":{"command":"xcodegen generate && xcodebuild test -scheme TruvideoSdk SWIFTSCOPE_PATHS="},"TruvideoSdkCamera":{"command":"xcodegen generate && xcodebuild test -scheme TruvideoSdkCamera SWIFTSCOPE_PATHS="}},"areas":{"App":{"suiteKeys":["TruvideoSdk"],"aliases":["TruVideoApp","TruvideoSdk","Core"]},"Camera":{"suiteKeys":["TruvideoSdkCamera"],"aliases":["TruvideoSdkCamera","Camera SDK","Media"]}}}]'
CORTEX_JIRA_PROJECT_REPOS=

# Only triage issues assigned to this Jira account (optional; also used by API webhook gate).
JIRA_AUTOMATION_ASSIGNEE_ACCOUNT_ID=

# Optional Jira custom field id whose value is owner/repo or a GitHub URL.
# JIRA_REPO_CUSTOM_FIELD_ID=customfield_10001

# Optional secrets for jira.triage suite subprocesses. TestRunner inherits these
# and mirrors them as TEST_RUNNER_* so xcodebuild test injects them into XCTest.
# Local/dev only — production: see apps/node/src/handlers/jira-triage/ROADMAP.md.
TRUVIDEO_ACCESS_TOKEN=
TRUVIDEO_REFRESH_TOKEN=

