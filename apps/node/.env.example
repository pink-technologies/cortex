# Optional path override for the Cortex Node TOML configuration directory.
# Default: <process.cwd()>/.cortex
# CORTEX_CONFIG_DIR=/absolute/or/relative/path/to/.cortex

# Secret values referenced from `.cortex/*.toml` (names are examples — TOML decides).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CURSOR_API_KEY=
GITHUB_TOKEN=
JIRA_API_TOKEN=

# Optional secrets for jira.triage suite subprocesses. TestRunner inherits these
# and mirrors them as TEST_RUNNER_* so xcodebuild test injects them into XCTest.
# Local/dev only — production: see apps/node/src/handlers/jira-triage/ROADMAP.md.
TRUVIDEO_ACCESS_TOKEN=
TRUVIDEO_REFRESH_TOKEN=
